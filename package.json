{
  "name": "cascade",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "scout": "node scripts/scout-index.mjs",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "prepare": "node -e \"const fs = require('fs'); const path = require('path'); const hookPath = '.git/hooks/post-merge'; const sourcePath = 'scripts/hooks/post-merge'; if (!fs.existsSync(hookPath) && fs.existsSync(sourcePath)) { fs.copyFileSync(sourcePath, hookPath); fs.chmodSync(hookPath, 0o755); console.log('✅ Git hook installed.'); }\""
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@xyflow/react": "^12.10.1",
    "dexie": "^4.3.0",
    "pixi.js": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@microsoft/eslint-formatter-sarif": "^3.1.0",
    "@playwright/test": "^1.58.2",
    "@tauri-apps/cli": "^2.5.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.3",
    "vitest": "^3.0.0"
  }
}
