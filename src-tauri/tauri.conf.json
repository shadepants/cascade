{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cascade",
  "version": "0.0.0",
  "identifier": "com.cascade.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cascade",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.anthropic.com"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  },
  "plugins": {
    "store": {
      "autosave": 300
    }
  }
}
